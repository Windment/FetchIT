{
    "name": "fetchit",
    "version": "1.2.9",
    "description": "简单易用且高效的音视频下载工具，支持众多平台，同时还支持直链加速下载其他文件",
    "main": "src/app/app.js",
    "scripts": {
        "start": "electron .",
        "pack": "node obfuscate.js && electron-builder --dir",
        "dist": "node obfuscate.js && electron-builder",
        "obfuscate": "node obfuscate.js"
    },
    "author": "Windment",
    "license": "GPL-3.0-only",
    "devDependencies": {
        "bytenode": "^1.6.0",
        "electron": "^16.0.0",
        "electron-builder": "^24.9.1",
        "javascript-obfuscator": "^5.5.0",
        "upx": "^1.0.6"
    },
    "build": {
        "appId": "com.windment.fetchit",
        "productName": "FetchIT",
        "directories": {
            "output": "dist",
            "app": "build"
        },
        "files": [
            "**/*"
        ],
        "extraResources": [
            {
                "from": "utils",
                "to": "utils"
            },
            {
                "from": "icons",
                "to": "icons"
            }
        ],
        "win": {
            "target": {
                "target": "nsis",
                "arch": [
                    "x64"
                ]
            },
            "icon": "icon.ico",
            "compression": "maximum"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}
